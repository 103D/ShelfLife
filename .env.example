# ---- Telegram ----
# Bot token from @BotFather (required)
BOT_TOKEN=123456789:AA-your-token-here

# Public HTTPS URL where this server is reachable. Used for the "Open app" button.
# Telegram Mini Apps REQUIRE https. For local testing use a tunnel, e.g.:
#   ngrok http 3000   ->   WEBAPP_URL=https://xxxx.ngrok-free.app
WEBAPP_URL=https://your-domain.example

# ---- Server ----
PORT=3000

# SQLite database file location
DB_PATH=./data/shelflife.db

# Directory with the built Mini App (static files served at the web root)
WEBAPP_STATIC_DIR=./public


# ---- Dev helpers ----
# Set DEV_AUTH=1 to allow calling the API without Telegram (e.g. from a plain
# browser during development). Uses a fixed dev user id. NEVER enable in prod.
DEV_AUTH=0
