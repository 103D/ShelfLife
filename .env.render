# Production environment for Render
# Copy to .env and fill in values, or set in Render Dashboard -> Environment

# ---- Telegram ----
BOT_TOKEN=your-bot-token-from-botfather

# Public HTTPS URL (Render provides this automatically as https://<service>.onrender.com)
# Do NOT set this manually - Render provides https://<service-name>.onrender.com
# WEBAPP_URL=https://your-service-name.onrender.com

# ---- Server ----
PORT=3000
NODE_ENV=production

# SQLite database location (on Render Disk)
DB_PATH=/var/data/shelflife.db

# Static files (Mini App build output)
WEBAPP_STATIC_DIR=./public

# Dev only - NEVER enable in production
DEV_AUTH=0
